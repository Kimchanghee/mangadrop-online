---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { site, abs } from '../site.config';
import '../styles/global.css';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  crumbs?: Crumb[];
  showCrumbs?: boolean;
  published?: string;
  updated?: string;
  preloadImage?: string;
}
const { title, description, path, ogImage = '/og/home.png', ogType = 'website', jsonld = [], crumbs = [], showCrumbs = true, published, updated, preloadImage } = Astro.props;
const canonical = abs(path);
const orgId = `${site.url}/#organization`;
const baseLd: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': orgId, name: site.name, alternateName: site.nameEn, url: site.url + '/', email: site.contactEmail, description: site.description, logo: abs('/favicon.svg') },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: site.url + '/', inLanguage: 'ko-KR', publisher: { '@id': orgId } },
];
if (crumbs.length) {
  baseLd.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })),
  });
}
const allLd = [...baseLd, ...jsonld];
const nav = [
  { href: '/guides/', label: '체크리스트' },
  ...site.categories.map((c) => ({ href: `/category/${c.slug}/`, label: c.name })),
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
  <link rel="preload" href="/fonts/GowunBatang-Bold.subset.woff2" as="font" type="font/woff2" crossorigin />
  {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
  <meta name="theme-color" content="#f4efe5" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={abs(ogImage)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={abs(ogImage)} />
  {published && <meta property="article:published_time" content={published} />}
  {updated && <meta property="article:modified_time" content={updated} />}
  <meta name="google-adsense-account" content={site.adsenseClient} />
  {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
  {site.naverVerification && <meta name="naver-site-verification" content={site.naverVerification} />}
  {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {site.adsEnabled && site.consentReady && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="mast">
    <div class="mast__in wrap">
      <a class="mast__brand" href="/" aria-label={`${site.name} 홈`}>{site.name}<small>{site.tagline}</small></a>
      <nav aria-label="주요 메뉴">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  {showCrumbs && crumbs.length > 1 && (
    <nav class="crumbs wrap" aria-label="현재 위치">
      <ol>{crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
    </nav>
  )}
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <p class="foot__brand">{site.name} <span>{site.tagline}</span></p>
        <p class="foot__disclosure"><strong>제휴 고지</strong> 일부 글에는 쿠팡 파트너스, 오늘의집, 토스쇼핑, 네이버 쇼핑커넥트 제휴 링크가 들어갈 수 있으며, 링크를 통해 구매하면 운영자가 일정 수수료를 받을 수 있습니다. 해당 글은 맨 위에 제휴 사실을 따로 밝힙니다.</p>
      </div>
      <ul class="foot__links">
        <li><a href="/about/">소개·편집 원칙</a></li>
        <li><a href="/methodology/">상품 선정 방법</a></li>
        <li><a href="/contact/">문의</a></li>
        <li><a href="/privacy/">개인정보처리방침</a></li>
        <li><a href="/terms/">이용약관</a></li>
        <li><a href="/disclaimer/">면책·제휴 안내</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <AnalyticsConsent />
  </footer>
</body>
</html>
