# Workers static assets response headers (2026-11-28). HTML keeps the platform default (revalidate).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/_thumbs/*
  Cache-Control: public, max-age=2592000
/images/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
